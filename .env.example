# Variables de Entorno para RAG HR Frontend
# Copia este archivo a .env y personaliza los valores

# ============================================================================
# CONFIGURACIÓN DE API
# ============================================================================
# URLs de los servicios de API
INGEST_API_URL=https://ca-ingesta-talentrefine-dev-spc--v3-20260528.internal.greenwave-4d796cb5.spaincentral.azurecontainerapps.io
PROCESS_API_URL=https://ca-proc-talentrefine-dev-spc--v3-20260528.internal.greenwave-4d796cb5.spaincentral.azurecontainerapps.io
API_URL=http://localhost:8000

# Timeout para las llamadas a la API (en segundos)
API_TIMEOUT=30

# ============================================================================
# CONFIGURACIÓN DE APLICACIÓN
# ============================================================================
# Modo de datos: True para mocks, False para API real
USE_MOCK_DATA=True

# Nivel de logging
LOG_LEVEL=INFO

# Modo debug
DEBUG_MODE=False

# ============================================================================
# CONFIGURACIÓN DE STREAMLIT (opcional, puede configurarse en .streamlit/config.toml)
# ============================================================================
# Puerto del servidor
STREAMLIT_SERVER_PORT=8501

# Dirección de escucha
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================================================
# Clave secreta para sesiones (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Token de autenticación (Fase 2)
# AUTH_TOKEN=your-auth-token-here

# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (Fase 2)
# ============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_hr

# ============================================================================
# CONFIGURACIÓN DE LLM (Fase 2)
# ============================================================================
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4
# TEMPERATURE=0.7

# ============================================================================
# CONFIGURACIÓN DE ALMACENAMIENTO
# ============================================================================
# UPLOAD_FOLDER=./uploads
# MAX_FILE_SIZE=26214400  # 25 MB en bytes
